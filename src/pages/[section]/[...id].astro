---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
export async function getStaticPaths() {
  const collections = await Promise.all(['blog', 'case-studies'].map(async (section) => {
    const entries = await getCollection(section as 'blog' | 'case-studies', ({ data }) => !data.draft);
    return entries.map(entry => ({ params: { section, id: entry.id }, props: { entry } }));
  }));
  return collections.flat();
}
interface Props { entry: CollectionEntry<'blog' | 'case-studies'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, topic } = entry.data;
const section = Astro.params.section!;
const base = import.meta.env.BASE_URL;
const markdown = `# ${title}\n\nBy Matthew Rabah\n\n${description}\n\n${entry.body ?? ''}`;
---
<ResumeLayout title={`${title} | Matthew Rabah`} description={description} pageType={section === 'blog' ? 'BlogPosting' : 'CreativeWork'} structuredData={{ headline: title, datePublished: pubDate!.toISOString() }}>
  <main id="main" class="shell" tabindex="-1">
    <article class="reading">
      <a href={`${base}${section}/`}>← All {section === 'blog' ? 'blog posts' : 'case studies'}</a>
      <p class="eyebrow">{topic ?? (section === 'blog' ? 'Blog' : 'Case study')}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="content-meta">By <a href={base}>Matthew Rabah</a> · <time datetime={pubDate!.toISOString()}>{pubDate!.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></p>
      <CopyMarkdown markdown={markdown} filename={`${entry.id.replaceAll('/', '-')}.md`} />
      <Content />
    </article>
  </main>
</ResumeLayout>
