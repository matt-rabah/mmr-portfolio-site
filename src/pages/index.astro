---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import { experience } from '../data/resume';
const pdfUrl = `${import.meta.env.BASE_URL}Matthew-Rabah-Resume.pdf`;
const markdownUrl = `${import.meta.env.BASE_URL}resume.md`;

---
<ResumeLayout>
  <a class="skip" href="#main">Skip to content</a>
  <header>
    <div class="shell navigation">
      <a class="wordmark" href={import.meta.env.BASE_URL}>
        <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 30V10L15 23L25 10V30M25 10H30C38 10 38 21 30 21H25M30 21L37 30" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="round" /></svg>Matthew Rabah</a>
      <nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#expertise">Expertise</a><a href="mailto:rabah.matthew@gmail.com">Contact</a></nav>
    </div>
  </header>
  <main id="main" class="shell">
    <section class="hero" aria-labelledby="name">
      <p class="greeting" id="greeting">Hello. Thanks for stopping by.</p>
      <p class="eyebrow">Customer experience · CRM · AI adoption</p>
      <h1 id="name">Matthew Rabah</h1>
      <p class="lead">Connecting customer needs, better workflows, and measurable outcomes.</p>
      <p class="intro">My experience spans luxury retail, AI-enabled medtech, and consulting. Across these settings, I’ve helped teams strengthen customer relationships, improve CRM practices, and turn technology into everyday habits that support adoption and retention.</p>
      <p class="intro">I bring business-side implementation experience: aligning stakeholders, improving processes, configuring CRM workflows, and training teams. My focus is how people use technology to deliver a better customer experience.</p>
      <div class="actions"><a class="button" href={pdfUrl} download="Matthew-Rabah-Resume.pdf">Download resume <span aria-hidden="true">&nbsp;↓</span><span class="sr-only"> (PDF)</span></a><button class="button button-secondary" id="copy-markdown" type="button" data-url={markdownUrl} hidden>Copy as Markdown</button><a href="mailto:rabah.matthew@gmail.com">Get in touch ↗</a></div>
      <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
      <div class="contact"><span>Detroit, Michigan</span><a href="mailto:rabah.matthew@gmail.com">rabah.matthew@gmail.com</a><a href="tel:+12482176573">248-217-6573</a><a href="https://www.linkedin.com/in/mattrabah/">LinkedIn ↗</a></div>
    </section>
    <div class="resume-grid">
      <section id="experience" aria-labelledby="experience-heading">
        <h2 id="experience-heading">Professional experience</h2>
        {experience.map((job) => <article>
          <div class="job-head"><h3>{job.company}</h3><span class="date">{job.dates}</span></div>
          <p class="role">{job.title}</p>
          <p class="eyebrow">{job.industry}</p>
          <p class="context">{job.context}</p>
          <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </article>)}
      </section>
      <aside aria-label="Qualifications">
        <section id="expertise" aria-labelledby="expertise-heading">
          <h2 id="expertise-heading">Areas of focus</h2>
          <ul class="tags">{['CX management', 'Customer retention', 'CRM improvement', 'Technology adoption', 'Lifecycle strategy', 'Team development', 'Stakeholder alignment', 'Customer analytics'].map((skill) => <li>{skill}</li>)}</ul>
        </section>
        <section aria-labelledby="tools-heading"><h2 id="tools-heading">Tools & platforms</h2><p>Salesforce · HubSpot · Gainsight · ChurnZero · Delighted · Jira · Confluence</p></section>
        <section aria-labelledby="education-heading"><h2 id="education-heading">Education</h2><h3>M.S., Customer Experience Management</h3><p>Michigan State University<br />Eli Broad College of Business</p><h3>B.S., Organizational Behavior</h3><p>Oakland University</p></section>
        <section aria-labelledby="certifications-heading"><h2 id="certifications-heading">Certifications</h2><h3>Salesforce Certified Agentforce Specialist</h3><p>Salesforce</p><h3>HubSpot Inbound Marketing</h3><p>HubSpot</p></section>
        <section aria-labelledby="speaking-heading"><h2 id="speaking-heading">Speaking</h2><p><strong>Creative Mornings Detroit</strong><br />Systems Thinking in Customer Experience</p><p><strong>MSU CXM360 Conference</strong><br />Loyalty Programs in Luxury Retail & Commercial Expansion</p><p><strong>University of Michigan</strong><br />Customer Experience & Revenue Operations</p></section>
      </aside>
    </div>
  </main>
  <footer><div class="shell">Matthew Rabah · Detroit, Michigan · <a href={pdfUrl} download>Resume PDF</a></div></footer>
  <script>
    const greeting = document.querySelector<HTMLElement>('#greeting');
    const updateGreeting = () => {
      const hour = new Date().getHours();
      const salutation = hour >= 5 && hour < 12 ? 'Good morning' : hour >= 12 && hour < 17 ? 'Good afternoon' : hour >= 17 && hour < 22 ? 'Good evening' : 'Hello, night owl';
      if (greeting) greeting.textContent = `${salutation}. Thanks for stopping by.`;
    };
    updateGreeting();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) updateGreeting(); });
    const button = document.querySelector<HTMLButtonElement>('#copy-markdown');
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (button) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          const response = await fetch(button.dataset.url!);
          if (!response.ok) throw new Error('Markdown unavailable');
          const markdown = await response.text();
          try {
            await navigator.clipboard.writeText(markdown);
            if (status) status.textContent = 'Copied. Thanks for taking a closer look.';
          } catch {
            const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }));
            const link = document.createElement('a');
            link.href = url; link.download = 'Matthew-Rabah-Resume.md'; link.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
            if (status) status.textContent = 'Clipboard unavailable. Your Markdown file has been downloaded.';
          }
        } catch {
          if (status) status.textContent = 'Couldn’t prepare the Markdown. Please try again.';
        } finally { button.disabled = false; }
      });
    }
  </script>
</ResumeLayout>
<style>.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }</style>
