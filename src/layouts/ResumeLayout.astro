---
import '../styles/fonts.css';
interface Props {
  title?: string;
  description?: string;
  pageType?: 'ProfilePage' | 'CollectionPage' | 'BlogPosting' | 'CreativeWork';
  structuredData?: Record<string, unknown>;
}
const {
  title = 'Matthew Rabah | Customer Experience & AI Adoption',
  description = "Matthew Rabah's experience across retail, medtech, and consulting: customer experience management, CRM improvement, and business-side technology adoption.",
  pageType = 'ProfilePage',
  structuredData = {},
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { label: 'Resume', path: '' },
  { label: 'Case studies', path: 'case-studies/' },
  { label: 'Blog', path: 'blog/' },
];
const person = {
  '@type': 'Person', name: 'Matthew Rabah',
  sameAs: ['https://www.linkedin.com/in/mattrabah/'],
  knowsAbout: ['Customer experience management', 'CRM improvement', 'AI adoption'],
};
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const schema = {
  '@context': 'https://schema.org', '@type': pageType,
  name: title, description, ...(canonical ? { url: canonical } : {}),
  ...(pageType === 'ProfilePage' ? { mainEntity: person } : { author: person }),
  ...structuredData,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Matthew Rabah" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Matthew Rabah" />
    <meta property="og:type" content={pageType === 'BlogPosting' ? 'article' : 'website'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}mark.svg`} />
    <meta name="theme-color" content="#f7f2e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211f1c" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="dark-header">
      <div class="shell navigation">
        <a class="wordmark" href={base}>
          <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 30V10L15 23L25 10V30M25 10H30C38 10 38 21 30 21H25M30 21L37 30" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="round" /></svg>Matthew Rabah
        </a>
        <nav aria-label="Main">
          {navigation.map(({ label, path }) => {
            const href = `${base}${path}`;
            const normalized = href.replace(/\/$/, '') || '/';
            const active = normalized === '/' ? currentPath === '/' : currentPath === normalized || currentPath.startsWith(`${normalized}/`);
            return <a href={href} aria-current={active ? 'page' : undefined}>{label}</a>;
          })}
          <a href="mailto:rabah.matthew@gmail.com">Contact</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="dark-footer"><div class="shell footer-inner"><span>Matthew Rabah · Detroit, Michigan</span><div class="footer-links"><a href="mailto:rabah.matthew@gmail.com">Contact</a><a href={`${base}Matthew-Rabah-Resume.pdf`} download>Resume PDF</a><a href="https://www.linkedin.com/in/mattrabah/">LinkedIn</a></div></div></footer>
  </body>
</html>
<style is:global>
  :root { --canvas: #f7f2e9; --ink: #292722; --muted: #625b51; --line: #d4cbbd; --surface: #eee6d9; --accent: #94472f; --button: #292722; --button-text: #f7f2e9; font-family: var(--font-serif); color: var(--ink); background: var(--canvas); color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --canvas: #211f1c; --ink: #eee7dc; --muted: #bdb2a3; --line: #514a40; --surface: #2d2924; --accent: #e4a185; --button: #eee7dc; --button-text: #211f1c; } }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; }
  a { color: inherit; text-underline-offset: .22em; }
  a:hover { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
  p, li { line-height: 1.7; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { text-wrap: balance; }
  .shell { max-width: 1160px; padding: 0 40px; margin: auto; }
  .skip { position: absolute; top: -100px; left: 16px; padding: 12px; background: var(--canvas); z-index: 2; }
  .skip:focus { top: 16px; }
  header { border-bottom: 1px solid var(--line); }
  .navigation { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 25px; }
  .wordmark { font-family: var(--font-sans); display: inline-flex; align-items: center; gap: 12px; font-weight: 700; text-decoration: none; letter-spacing: -.03em; font-size: 20px; }
  nav { font-family: var(--font-sans); display: flex; gap: 24px; flex-wrap: wrap; font-size: 14px; }
  nav a { text-decoration: none; }
  .hero { padding-block: 72px 64px; max-width: 900px; }
  .eyebrow { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; font-weight: 400; color: var(--accent); }
  h1 { font-family: var(--font-sans); font-size: clamp(48px, 7vw, 86px); line-height: 1.04; font-weight: 600; letter-spacing: -.04em; margin-bottom: 24px; }
  .lead { font-family: var(--font-serif); font-size: clamp(22px, 3vw, 30px); line-height: 1.35; max-width: 760px; letter-spacing: -.025em; }
  .intro { font-family: var(--font-serif); max-width: 700px; color: var(--muted); font-size: 19px; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 30px; }
  .button { display: inline-flex; padding: 15px 22px; border-radius: 4px; background: var(--button); color: var(--button-text); border: 1px solid var(--button); cursor: pointer; font-family: var(--font-sans); min-height: 46px; text-decoration: none; font-size: 14px; font-weight: 700; }
  .button:hover { background: var(--accent); border-color: var(--accent); color: var(--canvas); }
  .contact { font-family: var(--font-sans); display: flex; gap: 20px; flex-wrap: wrap; margin-top: 26px; font-size: 14px; color: var(--muted); }
  .resume-grid { display: grid; grid-template-columns: minmax(0, 1fr) 275px; gap: 65px; padding-bottom: 65px; }
  section { scroll-margin-top: 24px; }
  h2 { font-family: var(--font-mono); font-weight: 400; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; border-top: 1px solid var(--line); padding-top: 22px; margin-bottom: 28px; }
  article { padding-bottom: 26px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  article:last-child { border-bottom: 0; margin-bottom: 0; }
  .job-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px 20px; }
  h3 { font-family: var(--font-sans); font-size: 22px; margin-bottom: 7px; letter-spacing: -.025em; }
  .date { font-family: var(--font-mono); color: var(--muted); font-size: 13px; }
  .role { font-family: var(--font-sans); font-weight: 700; margin-bottom: 10px; }
  .context { font-family: var(--font-serif); color: var(--muted); font-size: 15px; }
  ul { padding-left: 20px; margin-bottom: 0; }
  li { padding-left: 4px; margin-bottom: 10px; font-size: 15px; }
  aside { background: var(--surface); padding: 0 24px 8px; align-self: start; border-radius: 6px; }
  aside section { margin-bottom: 32px; }
  aside h3 { font-family: var(--font-sans); font-size: 16px; margin-bottom: 6px; }
  aside p { font-size: 14px; color: var(--muted); }
  .tags { font-family: var(--font-sans); display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; }
  .tags li { border: 1px solid var(--line); padding: 6px 10px; margin: 0; border-radius: 3px; font-size: 12px; }
  footer { border-top: 1px solid var(--line); padding-block: 28px; color: var(--muted); font-size: 13px; }
  /* Remove dark-header from the page to keep only the dark footer. */
  :is(.dark-header, .dark-footer) {
    --accent: #e4a185;
    --line: #514a40;
    background: #191815;
    color: #eee7dc;
    color-scheme: dark;
  }
  .dark-header .navigation { padding-block: 28px; }
  .dark-header nav a { padding-block: 8px; }
  .dark-header nav a:hover { text-decoration: underline; text-underline-offset: .35em; }
  .dark-footer { padding-block: 48px; font-family: var(--font-sans); line-height: 1.8; }
  .dark-footer a { color: #eee7dc; }
  .dark-footer a:hover { color: var(--accent); }
  @media (max-width: 760px) { .shell { padding-inline: 24px; } .hero { padding-block: 50px 40px; } .resume-grid { grid-template-columns: 1fr; gap: 24px; } .navigation { align-items: flex-start; flex-direction: column; gap: 16px; } }
  @media print { :root { --canvas: white; --ink: black; --muted: #444; --line: #aaa; --surface: white; --accent: #444; background: white; color: black; color-scheme: light; } .shell { padding: 0; max-width: none; } header, .actions, .skip, .greeting, .copy-status, footer { display: none; } .hero { padding: 0 0 20px; } h1 { font-size: 36px; } .lead { font-family: var(--font-serif); font-size: 18px; } .intro, li { font-size: 11px; } .resume-grid { gap: 25px; grid-template-columns: minmax(0, 1fr) 210px; } article { break-inside: avoid; } }
  .brand-mark { width: 38px; height: 38px; color: var(--accent); flex: none; }
  .greeting { font-family: var(--font-serif); color: var(--muted); font-size: 18px; margin-bottom: 34px; }
  .greeting::before { content: '↳'; margin-right: 10px; color: var(--accent); }
  .button-secondary { background: transparent; border-color: var(--line); color: var(--ink); font-weight: 400; }
  .copy-status { font-family: var(--font-sans); min-height: 24px; font-size: 13px; color: var(--muted); margin: 12px 0 0; }
  nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: .35em; text-decoration-color: var(--accent); }
  .footer-inner, .footer-links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px 28px; }
  .page-content { padding-bottom: 80px; }
  .page-content .hero { max-width: 900px; }
  .library-grid { display: grid; grid-template-columns: minmax(0, 1fr) 275px; gap: 65px; }
  .empty-state { padding: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  .empty-state h3 { margin-bottom: 14px; }
  .empty-state p { max-width: 55ch; color: var(--muted); font-size: 18px; }
  .topic-list { list-style: none; padding: 0; margin: 0; }
  .topic-list li { font-family: var(--font-sans); padding: 12px 0; border-bottom: 1px solid var(--line); }
  .content-card h3 { font-size: 28px; }
  .content-card h3 a { text-decoration: none; }
  .content-card h3 a:hover { text-decoration: underline; }
  .content-meta { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .reading { max-width: 760px; margin-inline: auto; padding-block: 56px 80px; }
  .reading h1 { font-size: clamp(38px, 5vw, 60px); }
  .reading h2 { font-family: var(--font-serif); font-size: 30px; letter-spacing: -.02em; text-transform: none; border: none; margin-block: 36px 16px; }
  .reading p, .reading li { font-size: 19px; }
  .reading img { max-width: 100%; height: auto; }
  .reading pre { overflow-x: auto; padding: 20px; background: var(--surface); }
  .reading blockquote { margin-inline: 0; padding-inline-start: 24px; border-inline-start: 2px solid var(--accent); }
  @media (max-width: 760px) { .library-grid { grid-template-columns: 1fr; gap: 32px; } .empty-state { padding: 24px; } nav { gap: 16px; } }
</style>
